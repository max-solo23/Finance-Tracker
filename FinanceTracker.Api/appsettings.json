{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,https://financetracker-web-one.vercel.app"
  },
  "JwtSettings": {
